# Exclude general runtime artifacts
__pycache__/
.ipynb_checkpoints/
.venv/
lightning_logs/
checkpoints/
wandb/
tmp/
cache/
figure_outputs/
figure_scripts/**/outputs/
*.log

# Exclude generated analysis state and results; keep their contracts in Git
current_analysis/intermediate_objects/*
!current_analysis/intermediate_objects/README.md
current_analysis/results/*
!current_analysis/results/README.md

# Exclude containers and large data objects wherever they occur
*.sif
*.sif.*
*.RData
*.Rdata
*.rds
*.h5
*.h5ad
*.h5seurat

# Exclude R session state
/.RData
/.Rhistory
/.Rproj.user

# Exclude Nextflow logs
/.nextflow.log*
