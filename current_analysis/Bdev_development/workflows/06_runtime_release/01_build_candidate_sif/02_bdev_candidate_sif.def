    Rscript --vanilla -e 'expected <- c(scworkbench="0.1.2",scwbStatistics="0.1.0",scwbGenePrograms="0.1.0",scwbRNA="0.1.0",scwbRepresentation="0.1.1",scwbTrajectory="0.1.8",scwbLatent="0.1.3",scwbReferenceMap="0.1.0",scwbATAC="0.1.1"); observed <- vapply(names(expected), function(x) as.character(packageVersion(x)), character(1)); stopifnot(identical(observed, expected)); cat("BDEV_INSTALLED_VERSIONS_OK\n")'
    /opt/pyenv/bin/python -m pip check
    /opt/pyenv/bin/python -c 'import pybench, scvi, anndata, scipy, torch, ruptures; print("BDEV_PYTHON_RUNTIME_OK")'
    rm -rf /opt/scworkbench/.git /opt/operation_packs/*/.git /opt/bdev_runtime_update
