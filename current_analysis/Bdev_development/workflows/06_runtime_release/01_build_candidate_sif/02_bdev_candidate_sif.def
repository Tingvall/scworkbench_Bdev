%post
    set -eu
    case "amd64:$(uname -m)" in
        amd64:x86_64) ;;
        *) echo "Base SIF architecture does not match native build" >&2; exit 1 ;;
    esac
    rm -rf /opt/scworkbench /opt/operation_packs
    mv /opt/bdev_runtime_update/scworkbench /opt/scworkbench
    mv /opt/bdev_runtime_update/operation_packs /opt/operation_packs
    R CMD INSTALL --preclean --library=/usr/local/lib/R/site-library /opt/scworkbench
    for package in scwbStatistics scwbGenePrograms scwbRNA scwbRepresentation scwbTrajectory scwbLatent scwbReferenceMap scwbATAC; do
        R CMD INSTALL --preclean --library=/usr/local/lib/R/site-library "/opt/operation_packs/${package}"
